# OmniBounty environment variables (TEMPLATE ONLY - never put real values here).
#
# Copy nothing blindly: most workflows need only a subset. Sections below say
# which variables each workflow needs and whether each is required or optional.
# Machine-readable secret files live in gitignored locations instead:
#   frontend/.env.local  - Reclaim + GitHub credentials for proof scripts
#   secrets/*.json       - NEAR key files {"account_id","private_key"} (0600)
#   .near-credentials/   - (unused by tracked scripts; some wallets expect it)
# See JUDGES.md for the full setup and runbook. See frontend/.env.example for
# the browser-bundle variables (duplicated here for completeness).

# ---------------------------------------------------------------------------
# Read-only verification (judges: NOTHING required - every check below has a
# working default; set these only to point at a different deployment).
# ---------------------------------------------------------------------------
# NEAR JSON-RPC endpoint (read-only views + view_code verification).
NEAR_RPC_URL=https://rpc.testnet.near.org
# Deployed V3 contract account (read-only target, never redeployed by scripts).
NEAR_CONTRACT_ID=omnibounty-v3.testnet
# Base Sepolia JSON-RPC endpoint (read-only escrow/explorer checks).
BASE_RPC_URL=https://sepolia.base.org
# Deployed V3 escrow (read-only target).
ESCROW_ADDRESS=0x63391c272A49c30f79eb6c3d8E10F0652Bb0F767

# ---------------------------------------------------------------------------
# Local test suites (no secrets needed; all suites run offline except the
# NEAR sandbox first-run binary download - see JUDGES.md).
# ---------------------------------------------------------------------------
# No variables required. Optional harness controls (CI use; documented, not needed):
# OMNIBOUNTY_NETWORK=sandbox        # legacy near xsuite: sandbox|testnet (default sandbox)
# XSUITE_FIXTURE_TIME=1794440000    # pin regen timestamps for determinism checks
# XSUITE_FIXTURE_PATH=/tmp/fx.json  # alternate regen output (default testdata/v3/xsuite-claim.json)
# E2E_ESCROW_ADDRESS=0x...          # integration e2e: written by e2e:prepare, consumed by regen (CI wires these)
# E2E_TOKEN_ADDRESS=0x...
# E2E_CHAIN_ID=84532
# E2E_OUT_PATH=...                  # alternate e2e fixture output (default testdata/v3/e2e-vouchers.json)

# ---------------------------------------------------------------------------
# Testnet sponsorship + claiming (terminal E2E). REQUIRED for any step that
# sends a transaction; NOT needed for read-only verification or dry-runs.
# ---------------------------------------------------------------------------
# Path to the operator/sponsor/claimant NEAR key file (created by
# scripts/setup.sh as secrets/agent-near.json; point here to use it).
# Format: {"account_id":"<name>.testnet","private_key":"ed25519:..."}. 0600.
NEAR_KEY_FILE=secrets/agent-near.json

# ---------------------------------------------------------------------------
# Reclaim proof generation (live GitHub attestations). REQUIRED for fresh
# proofs; NOT needed for the recorded-proof fallback (see JUDGES.md).
# Prefer frontend/.env.local for these (auto-loaded by prove scripts);
# shell exports take precedence. NEVER prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# RECLAIM_APP_ID=0x...        # Reclaim zkFetch app id (Reclaim portal; same pair for both proofs)
# RECLAIM_APP_SECRET=0x...    # Reclaim app secret (server-side only, never in the browser)
# GITHUB_TOKEN=ghp_...        # Claimant's own GitHub token (profile-read suffices; short-lived, revocable)

# ---------------------------------------------------------------------------
# Relayer operation (settlement + auto-finalize). REQUIRED to run the relayer;
# NOT needed for read-only verification. See relayer/src/config.mjs.
# ---------------------------------------------------------------------------
# NEAR_RPC_URL=https://rpc.testnet.near.org        # (as above)
# NEAR_CONTRACT_ID=omnibounty-v3.testnet        # (as above)
# BASE_RPC_URL=https://sepolia.base.org              # (as above)
# ESCROW_ADDRESS=0x63391c272A49c30f79eb6c3d8E10F0652Bb0F767  # (as above)
# MPC_SIGNER_ADDRESS=0x4b204ae1890a0cd49cc594fe712fea4ac765a2f9  # on-chain voucher signer (must match get_config)
# RELAYER_PRIVATE_KEY=0x...                    # EVM key paying Base gas (needs Sepolia ETH only, never holds USDC)
# EXPECTED_CHAIN_ID=84532                      # optional (default 84532)
# POLL_INTERVAL_MS=30000                       # optional (default 30000, min 1000)
# CONFIRMATIONS=2                              # optional (default 2)
# MAX_ATTEMPTS=5                               # optional (default 5)
# STATE_PATH=./relayer-state.json              # optional (default ./relayer-state.json, gitignored)
# VOUCHER_VERSION=2                            # optional (default 1! set 2 for the V3 escrow)
# NEAR_OPERATOR_ACCOUNT_ID=....testnet         # optional; enables auto-finalize ONLY together with:
# NEAR_OPERATOR_PRIVATE_KEY=ed25519:...        # optional; both or neither (setter rejects halves)
# FINALIZE_ENABLED=true                        # optional (default true; "false" runs settlement-only)

# ---------------------------------------------------------------------------
# Scheduler keeper (GitHub Actions only - repository secret, never a file).
# ---------------------------------------------------------------------------
# NEAR_OPERATOR_KEY_JSON={"account_id":"....testnet","private_key":"ed25519:..."}
#   Single-line JSON in Actions secrets; consumed only by
#   .github/workflows/finalize-scheduler.yml (currently REVIEW DRAFT).

# ---------------------------------------------------------------------------
# Frontend browser bundle (public values only - embedded in shipped JS).
# Duplicated from frontend/.env.example; no secrets here ever.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
# NEXT_PUBLIC_CONTRACT_ID=omnibounty-v3.testnet
# NEXT_PUBLIC_NETWORK_ID=testnet
# NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
# NEXT_PUBLIC_ESCROW_ADDRESS=0x63391c272A49c30f79eb6c3d8E10F0652Bb0F767
# NEXT_PUBLIC_CHAIN_ID=84532
# NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ---------------------------------------------------------------------------
# Observed but NOT used by tracked workflows (documented so nothing is
# silently omitted; do not set these expecting an effect):
#   NEAR_ACCOUNT_ID / NEAR_PRIVATE_KEY  - root-.env convention of archived
#       one-off operator scripts (audit-backup, untracked); tracked scripts
#       use NEAR_KEY_FILE instead.
#   V3_DEPLOYER_PRIVATE_KEY             - same; EVM deploy key of archived scripts.
#   SPONSOR_PRIVATE_KEY / V2_KEY_BACKUP_PASSPHRASE - present in operator-local
#       .env files; no tracked code path reads them.
#   EXPECT_WASM_SHA / VOUCHER_PATH / MPC_SIGNER_ADDRESS (tools/) - legacy V2
#       deploy scripts (tools/deploy_*.mjs, tools/set_escrow.mjs); V2 history only.
#   NEAR_HOST_STUBS_DIR / CARGO_HOME    - build-internal shims, not workflows.
# ---------------------------------------------------------------------------
