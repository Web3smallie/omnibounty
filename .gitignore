# Local cargo sandbox workaround (rebuilt by tools/local_registry.py)
vendor/
contracts/near/.cargo/
# Windows-sandbox mirror config lives in CARGO_HOME (.cargo-home/), never
# in the repo tree: a repo-local source replacement would leak Windows
# paths into Linux checkouts. (Phase 5.1 follow-up.)
contracts/near-v3/.cargo/

