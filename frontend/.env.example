# Public frontend config (embedded in the browser bundle - no secrets).
# Defaults below target the V3 deployment (see
# testdata/production_testnet_v3.json for the verified testnet values).
# Relayer-side V3 mode is selected separately with VOUCHER_VERSION=2.
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_CONTRACT_ID=omnibounty-v3.testnet
NEXT_PUBLIC_NETWORK_ID=testnet
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ESCROW_ADDRESS=0x63391c272A49c30f79eb6c3d8E10F0652Bb0F767
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# NEAR indexer for transaction-anchored criteria recovery (read-only receipt
# discovery; every recovered document is re-verified against the on-chain
# hash). Defaults to the testnet host below (mainnet when NETWORK_ID=mainnet).
# NEXT_PUBLIC_NEAR_INDEXER_URL=https://api-testnet.nearblocks.io

# Legacy V2 deployment (override in .env.local only to inspect historical
# V1/V2 records; the V3-only UI no longer offers V1 creation).
# NEXT_PUBLIC_CONTRACT_ID=v2.omnibounty.testnet
# NEXT_PUBLIC_ESCROW_ADDRESS=0xee5C8F3154fed8B9B2f5D820AC687fDfa8CF2C99

# Server-side only (prove script; loaded automatically from .env.local,
# shell variables take precedence). NEVER prefix with NEXT_PUBLIC_.
# RECLAIM_APP_ID=0x...
# RECLAIM_APP_SECRET=0x...
